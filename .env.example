# BoostAI optional configuration.
# Copy to `.env` (never commit it). Everything here is optional:
# BoostAI works fully without AI and without any API key.

# Optional cloud AI keys. You can also enter them in Settings, where they are
# stored in Windows Credential Manager instead of a file.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: override the Ollama endpoint (default http://localhost:11434)
# BOOSTAI_OLLAMA_URL=http://localhost:11434

# Optional: store database/logs/settings somewhere other than %LOCALAPPDATA%\BoostAI
# BOOSTAI_DATA_DIR=C:\path\to\folder
